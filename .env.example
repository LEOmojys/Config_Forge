# ConfigForge - Game Config Generation Agent Workbench
# Copy to .env and fill in values

# LLM Provider
# Leave blank for Mock Provider (MVP mode, no API key needed)

# Volcengine/Doubao Coding Plan API Key
# Apply at: https://console.volcengine.com/ark
ARK_CODING_API_KEY=
# Legacy-compatible aliases, read in order by the app:
# DOUBAO_API_KEY=
# ARK_API_KEY=

# Volcengine/Doubao Coding Plan Base URL
ARK_CODING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# Default Coding Plan model
ARK_CODING_MODEL=ark-code-latest
# Optional comma-separated fallbacks. Only add models confirmed compatible with
# your Coding Plan account and endpoint.
ARK_CODING_MODEL_FALLBACKS=

# DeepSeek API Key (critic side, heterogeneous review)
# Apply at: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
